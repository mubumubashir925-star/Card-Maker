<UserControl x:Class="CardMakerPro.UI.Workspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 MinWidth="560" MinHeight="440" Background="#F6F8FB">
 <UserControl.Resources>
  <SolidColorBrush x:Key="Accent" Color="#245DDB"/>
  <Style TargetType="Button">
   <Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="13,9"/>
   <Setter Property="Margin" Value="0,0,8,8"/>
   <Setter Property="Background" Value="#E8EEF9"/>
   <Setter Property="Foreground" Value="#1C3359"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".82"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".42"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="144"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#162D52">
   <StackPanel Margin="14,22,8,12">
    <TextBlock Text="CARD MAKER" Foreground="White" FontSize="16" FontWeight="Bold"/>
    <TextBlock Text="PRO" Foreground="#90B8FF" FontSize="11" Margin="0,0,0,26"/>
    <Button x:Name="CardsNav" Content="Cards" Click="Navigate_Click" Tag="Cards"/>
    <Button x:Name="DataNav" Content="Data" Click="Navigate_Click" Tag="Data"/>
    <Button x:Name="ImagesNav" Content="Images" Click="Navigate_Click" Tag="Images"/>
    <Button x:Name="CodesNav" Content="QR / Barcode" Click="Navigate_Click" Tag="QR / Barcode"/>
    <Button x:Name="ArrangeNav" Content="Arrange" Click="Navigate_Click" Tag="Arrange"/>
    <Button x:Name="SettingsNav" Content="Settings" Click="Navigate_Click" Tag="Settings"/>
   </StackPanel>
  </Border>
  <Grid Grid.Column="1" Margin="22,18,20,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel>
    <TextBlock x:Name="PageTitle" Text="Cards" FontSize="23" FontWeight="Bold" Foreground="#172B4D"/>
    <TextBlock Text="Printo Cards and Technologies" Foreground="#73849B" Margin="0,4,0,20"/>
   </StackPanel>
   <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18">
    <StackPanel>
     <TextBlock x:Name="PageDescription" Text="Card production workspace" FontSize="16" FontWeight="SemiBold" Foreground="#172B4D"/>
     <TextBlock Text="The plugin interface is ready. CorelDRAW actions will become available after the host adapter is connected." TextWrapping="Wrap" Foreground="#73849B" Margin="0,12,0,18"/>
     <WrapPanel>
      <Button x:Name="PrimaryAction" Content="Generate cards" Background="#245DDB" Foreground="White" IsEnabled="False"/>
      <Button Content="Import data" IsEnabled="False"/>
     </WrapPanel>
    </StackPanel>
   </Border>
   <DockPanel Grid.Row="2" Margin="0,14,0,0">
    <TextBlock x:Name="StatusText" Text="UI preview • Not connected to CorelDRAW" Foreground="#73849B"/>
   </DockPanel>
  </Grid>
 </Grid>
</UserControl>
